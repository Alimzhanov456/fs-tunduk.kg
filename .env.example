# Copy this file to .env for local runs (python-dotenv loads it automatically
# if you add `from dotenv import load_dotenv; load_dotenv()` at the top of
# app.py — or just `export` these yourself before running).

# Password for the /admin panel. CHANGE THIS before deploying anywhere public.
ADMIN_PASSWORD=change-me

# Random secret used to sign Flask's session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# Optional: a hosted Postgres connection string (Neon, Supabase, Railway...).
# If unset, the app falls back to a local SQLite file (local.db), which is
# fine for testing but NOT reliable once deployed on a host that wipes its
# disk on redeploy.
# DATABASE_URL=postgresql://user:password@host/dbname
